common --enable_bzlmod
common --repo_env=GIT_CONFIG_GLOBAL=/dev/null
common --repo_env=GHOT_NIX_ANGR_ROOT
common --repo_env=GHOT_NIX_LIBSTDCXX_ROOT
common --repo_env=GHOT_REAPI_WORKER_RUNTIME_ROOT
build --show_result=20
build --incompatible_strict_action_env
build --spawn_strategy=sandboxed

# Ghot's qualified Linux fleet profile, retained without local fallback.
build:reapi --remote_executor=grpc://100.105.171.89:51051
build:reapi --remote_cache=grpc://100.105.171.89:51051
build:reapi --platforms=//tools:reapi_linux_x86_64
build:reapi --extra_execution_platforms=//tools:reapi_linux_x86_64
build:reapi --build_python_zip=false
build:reapi --spawn_strategy=remote
build:reapi --strategy=CopyFile=local
build:reapi --remote_local_fallback=false
build:reapi --remote_download_outputs=toplevel
build:reapi --jobs=48

# Optional BuildBuddy cache and invocation links for GitHub Actions. The CI
# wrapper adds this profile only when BUILDBUDDY_ORG_API_KEY is available.
build:buildbuddy_ci --build_metadata=ROLE=CI
build:buildbuddy_ci --bes_results_url=https://app.buildbuddy.io/invocation/
build:buildbuddy_ci --bes_backend=grpcs://remote.buildbuddy.io
build:buildbuddy_ci --remote_cache=grpcs://remote.buildbuddy.io

common --repo_env=IFRL_ANGR_ENVIRONMENT
common --repo_env=WRUH_AYXG_SOURCE
