@prefix bfe: <https://github.com/heartpunk/wruh/blob/main/docs/proposal/ontology/binary-function-extraction.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://github.com/heartpunk/wruh/blob/main/docs/proposal/ontology/binary-function-extraction.ttl>
    a owl:Ontology ;
    owl:imports <http://www.w3.org/ns/prov#> ;
    owl:versionInfo "0.1.0-draft" ;
    rdfs:label "Binary Function Extraction Census Ontology"@en ;
    rdfs:comment "A small draft vocabulary for describing binary function extraction censuses across target types and their provenance. The GitHub-based namespace is provisional and must be settled before external publication."@en .

### Core provenance-specialized classes

bfe:AnalyzedImage a owl:Class ;
    rdfs:subClassOf prov:Collection ;
    rdfs:label "analyzed binary image"@en ;
    rdfs:comment "A pinned set of binary objects analyzed together as one target. It does not imply a running or fully initialized process."@en .

bfe:InterpreterImage a owl:Class ;
    rdfs:subClassOf bfe:AnalyzedImage ;
    rdfs:label "interpreter image"@en ;
    rdfs:comment "An analyzed binary image whose target is an interpreter implementation and its selected runtime objects."@en .

bfe:BinaryObject a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "binary object"@en ;
    rdfs:comment "An executable, shared object, or other binary object included in an analyzed image."@en .

bfe:BuildActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "build activity"@en ;
    rdfs:comment "An evidenced activity that generates any combination of binary objects, analyzed images, and tool releases shown by its actual outputs. Its specific inputs and tool releases are recorded as provenance; this class does not by itself assert reproducibility or source-level correspondence."@en .

bfe:InventoryPolicy a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "inventory policy"@en ;
    rdfs:comment "The declared rules used to enumerate, identify, include, alias, bound, and exclude function candidates."@en .

bfe:InventoryGeneration a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "inventory generation"@en ;
    rdfs:comment "An activity that applies an inventory policy to an analyzed binary image using identified analysis-tool releases and produces a function inventory."@en .

bfe:FunctionInventory a owl:Class ;
    rdfs:subClassOf prov:Collection ;
    rdfs:label "function inventory"@en ;
    rdfs:comment "A collection of function candidates generated by an inventory-generation activity under a stated policy. Its membership defines the candidate universe for the corresponding census."@en .

bfe:FunctionCandidate a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "function candidate"@en ;
    rdfs:comment "A target-specific unit selected for a function extraction census. This designation does not by itself assert that the unit is one unique source-level or semantic function."@en .

bfe:ExtractionCensus a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "extraction census"@en ;
    rdfs:comment "An activity that analyzes a pinned binary image and reports outcomes for a function inventory."@en .

bfe:FunctionExtractionAttempt a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "function extraction attempt"@en ;
    rdfs:comment "An activity that attempts to produce an extraction artifact for one function candidate. Retries are represented as distinct activities."@en .

bfe:CensusEntry a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "census entry"@en ;
    rdfs:comment "A run-scoped record that assigns a reported disposition to a candidate and can link its attempts and observations. One entry per selected candidate is the intended data convention, not an OWL cardinality constraint."@en .

bfe:ExtractionArtifact a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "extraction artifact"@en ;
    rdfs:comment "A model or other output generated by an extraction attempt. Its existence does not assert whole-runtime semantic completeness."@en .

bfe:FailureObservation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "failure observation"@en ;
    rdfs:comment "A recorded diagnostic or blocker observed during an extraction attempt. It records an observation, not necessarily a root cause."@en .

bfe:InterruptionObservation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "interruption observation"@en ;
    rdfs:comment "A recorded interruption such as timeout, out-of-memory termination, worker loss, or host/transport interruption. An interruption is distinct from a semantic extraction failure."@en .

bfe:OpenBoundaryObservation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "open boundary observation"@en ;
    rdfs:comment "A recorded transfer, relocation, initialization, or other boundary that an artifact leaves unresolved. Its presence does not make an otherwise valid extraction a failure."@en .

bfe:ToolRelease a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "tool release"@en ;
    rdfs:comment "An identified release or revision of software used in build, inventory, census, or extraction activities. This is kept separate from the responsible prov:SoftwareAgent."@en .

### Relations

bfe:buildUsesInput a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain bfe:BuildActivity ;
    rdfs:range prov:Entity ;
    rdfs:label "build uses input"@en ;
    rdfs:comment "Use for a recorded build input such as a source revision, build recipe, configuration, dependency lock, or other input entity. This does not model source-to-binary function correspondence."@en .

bfe:buildGeneratesBinaryObject a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain bfe:BuildActivity ;
    rdfs:range bfe:BinaryObject ;
    rdfs:label "build generates binary object"@en .

bfe:buildGeneratesImage a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain bfe:BuildActivity ;
    rdfs:range bfe:AnalyzedImage ;
    rdfs:label "build generates analyzed image"@en .

bfe:buildGeneratesToolRelease a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain bfe:BuildActivity ;
    rdfs:range bfe:ToolRelease ;
    rdfs:label "build generates tool release"@en .

bfe:hasBinaryObject a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:hadMember ;
    rdfs:domain bfe:AnalyzedImage ;
    rdfs:range bfe:BinaryObject ;
    rdfs:label "has binary object"@en .

bfe:inventoryGenerationUsesImage a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain bfe:InventoryGeneration ;
    rdfs:range bfe:AnalyzedImage ;
    rdfs:label "inventory generation uses image"@en .

bfe:inventoryGenerationUsesPolicy a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain bfe:InventoryGeneration ;
    rdfs:range bfe:InventoryPolicy ;
    rdfs:label "inventory generation uses policy"@en .

bfe:generatesInventory a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain bfe:InventoryGeneration ;
    rdfs:range bfe:FunctionInventory ;
    rdfs:label "generates inventory"@en .

bfe:hasCandidate a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:hadMember ;
    rdfs:domain bfe:FunctionInventory ;
    rdfs:range bfe:FunctionCandidate ;
    rdfs:label "has candidate"@en .

bfe:censusUsesImage a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain bfe:ExtractionCensus ;
    rdfs:range bfe:AnalyzedImage ;
    rdfs:label "census uses image"@en .

bfe:censusUsesInventory a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain bfe:ExtractionCensus ;
    rdfs:range bfe:FunctionInventory ;
    rdfs:label "census uses inventory"@en .

bfe:censusGeneratesEntry a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain bfe:ExtractionCensus ;
    rdfs:range bfe:CensusEntry ;
    rdfs:label "census generates entry"@en .

bfe:activityUsesToolRelease a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain prov:Activity ;
    rdfs:range bfe:ToolRelease ;
    rdfs:label "activity uses tool release"@en ;
    rdfs:comment "Use this on each build, inventory, census, or extraction-attempt activity to identify the exact software releases or revisions actually used by that activity. Tool names such as Bazel, Nix, angr, and WRUH are recorded as data, not hard-coded ontology classes."@en .

bfe:inventoryGenerationUsesToolRelease a owl:ObjectProperty ;
    rdfs:subPropertyOf bfe:activityUsesToolRelease ;
    rdfs:domain bfe:InventoryGeneration ;
    rdfs:range bfe:ToolRelease ;
    rdfs:label "inventory generation uses tool release"@en ;
    rdfs:comment "Use one relation per exact tool version or source revision that participates in generating this inventory, such as angr and WRUH releases in a WRUH-based workflow."@en .

bfe:attemptsCandidate a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain bfe:FunctionExtractionAttempt ;
    rdfs:range bfe:FunctionCandidate ;
    rdfs:label "attempts candidate"@en .

bfe:entryRecordsCandidate a owl:ObjectProperty ;
    rdfs:domain bfe:CensusEntry ;
    rdfs:range bfe:FunctionCandidate ;
    rdfs:label "entry records candidate"@en .

bfe:entryHasAttempt a owl:ObjectProperty ;
    rdfs:domain bfe:CensusEntry ;
    rdfs:range bfe:FunctionExtractionAttempt ;
    rdfs:label "entry has attempt"@en .

bfe:entryDisposition a owl:ObjectProperty ;
    rdfs:domain bfe:CensusEntry ;
    rdfs:range bfe:Disposition ;
    rdfs:label "entry disposition"@en ;
    rdfs:comment "The reported terminal disposition for this candidate in this census. Blocked and failed preserve source-report wording; this property does not assert that those labels have one shared cross-target meaning. Dataset validation should check the intended single value; OWL does not close the world or enforce one value here."@en .

bfe:generatesArtifact a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain bfe:FunctionExtractionAttempt ;
    rdfs:range bfe:ExtractionArtifact ;
    rdfs:label "generates artifact"@en .

bfe:observesFailure a owl:ObjectProperty ;
    rdfs:domain bfe:FunctionExtractionAttempt ;
    rdfs:range bfe:FailureObservation ;
    rdfs:label "observes failure"@en .

bfe:observesInterruption a owl:ObjectProperty ;
    rdfs:domain bfe:FunctionExtractionAttempt ;
    rdfs:range bfe:InterruptionObservation ;
    rdfs:label "observes interruption"@en .

bfe:observesOpenBoundary a owl:ObjectProperty ;
    rdfs:domain bfe:FunctionExtractionAttempt ;
    rdfs:range bfe:OpenBoundaryObservation ;
    rdfs:label "observes open boundary"@en .

bfe:boundaryInArtifact a owl:ObjectProperty ;
    rdfs:domain bfe:OpenBoundaryObservation ;
    rdfs:range bfe:ExtractionArtifact ;
    rdfs:label "boundary in artifact"@en .

bfe:entryFirstFailure a owl:ObjectProperty ;
    rdfs:domain bfe:CensusEntry ;
    rdfs:range bfe:FailureObservation ;
    rdfs:label "entry first observed failure"@en ;
    rdfs:comment "Optional summary pointer to the first failure observation used in a first-failure report. Other observations remain independently representable."@en .

bfe:entryFirstInterruption a owl:ObjectProperty ;
    rdfs:domain bfe:CensusEntry ;
    rdfs:range bfe:InterruptionObservation ;
    rdfs:label "entry first observed interruption"@en .

bfe:candidateInObject a owl:ObjectProperty ;
    rdfs:domain bfe:FunctionCandidate ;
    rdfs:range bfe:BinaryObject ;
    rdfs:label "candidate in object"@en .

bfe:candidateIdentityBasis a owl:ObjectProperty ;
    rdfs:domain bfe:FunctionCandidate ;
    rdfs:range bfe:IdentityBasis ;
    rdfs:label "candidate identity basis"@en .

bfe:candidateAddressSpace a owl:ObjectProperty ;
    rdfs:domain bfe:FunctionCandidate ;
    rdfs:range bfe:AddressSpace ;
    rdfs:label "candidate address space"@en ;
    rdfs:comment "The numeric address value is interpreted only in the explicitly stated address space. If unknown, use bfe:UnknownAddressSpace rather than inferring one."@en .

### Descriptive properties

bfe:identifier a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "identifier"@en ;
    rdfs:comment "An optional literal identifier. No domain is asserted so an activity identifier does not entail that the activity is also a prov:Entity; the RDF subject IRI remains available as an identifier."@en .

bfe:contentDigest a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "content digest"@en ;
    rdfs:comment "A digest string, preferably including an algorithm prefix such as sha256:."@en .

bfe:targetVersion a owl:DatatypeProperty ;
    rdfs:domain bfe:AnalyzedImage ;
    rdfs:range xsd:string ;
    rdfs:label "target version"@en .

bfe:targetSourceRevision a owl:DatatypeProperty ;
    rdfs:domain bfe:AnalyzedImage ;
    rdfs:range xsd:string ;
    rdfs:label "target source revision"@en .

bfe:distributionRevision a owl:DatatypeProperty ;
    rdfs:domain bfe:AnalyzedImage ;
    rdfs:range xsd:string ;
    rdfs:label "target distribution revision"@en .

bfe:targetBuildConfiguration a owl:DatatypeProperty ;
    rdfs:domain bfe:AnalyzedImage ;
    rdfs:range xsd:string ;
    rdfs:label "target build configuration"@en .

bfe:targetPlatform a owl:DatatypeProperty ;
    rdfs:domain bfe:AnalyzedImage ;
    rdfs:range xsd:string ;
    rdfs:label "target platform"@en .

bfe:interpreterImplementation a owl:DatatypeProperty ;
    rdfs:domain bfe:InterpreterImage ;
    rdfs:range xsd:string ;
    rdfs:label "interpreter implementation"@en ;
    rdfs:comment "The interpreter-specific subtype can record an implementation name such as CPython, Lua, or QuickJS. Its version is represented by the inherited targetVersion property."@en .

bfe:candidateAliasIdentifier a owl:DatatypeProperty ;
    rdfs:domain bfe:FunctionCandidate ;
    rdfs:range xsd:string ;
    rdfs:label "candidate alias identifier"@en .

bfe:toolName a owl:DatatypeProperty ;
    rdfs:domain bfe:ToolRelease ;
    rdfs:range xsd:string ;
    rdfs:label "tool name"@en .

bfe:revision a owl:DatatypeProperty ;
    rdfs:domain bfe:ToolRelease ;
    rdfs:range xsd:string ;
    rdfs:label "revision"@en ;
    rdfs:comment "Record the exact tool version, distribution build identifier, or full source revision appropriate to the tool; do not use a moving label when a fixed revision is available."@en .

bfe:inventoryDescription a owl:DatatypeProperty ;
    rdfs:domain bfe:InventoryPolicy ;
    rdfs:range xsd:string ;
    rdfs:label "inventory description"@en ;
    rdfs:comment "Human-readable account of candidate unit, alias policy, extent policy, and exclusions. A future version may split these if observed data require it."@en .

bfe:candidateAddressValue a owl:DatatypeProperty ;
    rdfs:domain bfe:FunctionCandidate ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "candidate address value"@en .

bfe:declaredExtentBytes a owl:DatatypeProperty ;
    rdfs:domain bfe:FunctionCandidate ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "declared extent in bytes"@en ;
    rdfs:comment "An optional extent reported by the inventory policy; it is not assumed to be a complete semantic function boundary."@en .

bfe:recoveredExtentBytes a owl:DatatypeProperty ;
    rdfs:domain bfe:FunctionCandidate ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "recovered block envelope in bytes"@en ;
    rdfs:comment "An inferred envelope from an inventory provider's recovered blocks, not a declared symbol extent or proof of a complete semantic function boundary. Retain the provider's block-range evidence."@en .

bfe:failureStage a owl:DatatypeProperty ;
    rdfs:domain bfe:FailureObservation ;
    rdfs:range xsd:string ;
    rdfs:label "failure stage"@en .

bfe:failureCode a owl:DatatypeProperty ;
    rdfs:domain bfe:FailureObservation ;
    rdfs:range xsd:string ;
    rdfs:label "failure code"@en .

bfe:diagnosticText a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "diagnostic text"@en .

bfe:reportedDispositionLabel a owl:DatatypeProperty ;
    rdfs:domain bfe:CensusEntry ;
    rdfs:range xsd:string ;
    rdfs:label "reported disposition label"@en ;
    rdfs:comment "Optional exact status text from the source ledger or report, retained alongside the local disposition value."@en .

bfe:interruptionKind a owl:DatatypeProperty ;
    rdfs:domain bfe:InterruptionObservation ;
    rdfs:range xsd:string ;
    rdfs:label "interruption kind"@en .

bfe:boundaryKind a owl:DatatypeProperty ;
    rdfs:domain bfe:OpenBoundaryObservation ;
    rdfs:range xsd:string ;
    rdfs:label "boundary kind"@en .

bfe:boundaryTarget a owl:DatatypeProperty ;
    rdfs:domain bfe:OpenBoundaryObservation ;
    rdfs:range xsd:string ;
    rdfs:label "boundary target"@en .

### Open local value sets; these individuals are examples, not exhaustive enumerations.

bfe:Disposition a owl:Class ;
    rdfs:label "census disposition"@en ;
    rdfs:comment "A locally reported status for a census entry. The listed individuals are initial values, not a closed exhaustive enumeration."@en .

bfe:Extracted a owl:NamedIndividual, bfe:Disposition ;
    rdfs:label "extracted"@en ;
    rdfs:comment "The source report says an extraction artifact was produced."@en .
bfe:Blocked a owl:NamedIndividual, bfe:Disposition ;
    rdfs:label "blocked"@en ;
    rdfs:comment "The source report labels the candidate blocked. Preserve this term without assuming it is identical to every target's failed status."@en .
bfe:Failed a owl:NamedIndividual, bfe:Disposition ;
    rdfs:label "failed"@en ;
    rdfs:comment "The source report labels the extraction failed. Preserve this term without inferring a shared root cause or equating it to blocked."@en .
bfe:Incomplete a owl:NamedIndividual, bfe:Disposition ;
    rdfs:label "incomplete"@en ;
    rdfs:comment "The census cannot report a completed extraction outcome, for example because of an interruption or resource limit."@en .
bfe:Excluded a owl:NamedIndividual, bfe:Disposition ;
    rdfs:label "excluded"@en ;
    rdfs:comment "The candidate is represented in this census inventory but the run explicitly excludes it from extraction."@en .
bfe:NotAttempted a owl:NamedIndividual, bfe:Disposition ;
    rdfs:label "not attempted"@en ;
    rdfs:comment "No extraction attempt is recorded, and the run does not explicitly report the candidate as excluded."@en .

bfe:IdentityBasis a owl:Class ;
    rdfs:label "identity basis"@en ;
    rdfs:comment "The evidence or policy used to distinguish a function candidate within an inventory."@en .

bfe:SizedSymbol a owl:NamedIndividual, bfe:IdentityBasis ;
    rdfs:label "sized symbol"@en ;
    rdfs:comment "A candidate is keyed by a symbol-table entry with a declared size, subject to the stated alias policy."@en .
bfe:CFGFastEntry a owl:NamedIndividual, bfe:IdentityBasis ;
    rdfs:label "CFGFast recovered entry"@en ;
    rdfs:comment "An entry recovered by bounded static CFGFast discovery, with heuristic block membership and completion status retained in the inventory-generation evidence."@en .
bfe:UniqueEntryAddress a owl:NamedIndividual, bfe:IdentityBasis ;
    rdfs:label "unique entry address"@en ;
    rdfs:comment "Candidates are keyed by deduplicated function entry addresses, subject to the stated symbol-boundary and alias policies."@en .
bfe:InventoryIndex a owl:NamedIndividual, bfe:IdentityBasis ;
    rdfs:label "inventory index"@en ;
    rdfs:comment "A candidate is keyed by a retained index in a particular inventory; preserve that inventory identity with the index."@en .
bfe:OtherIdentityBasis a owl:NamedIndividual, bfe:IdentityBasis ; rdfs:label "other identity basis"@en .

bfe:AddressSpace a owl:Class ;
    rdfs:label "address space"@en ;
    rdfs:comment "The coordinate system in which a candidate's numeric address is meaningful. Listed values are illustrative, not exhaustive."@en .

bfe:FileOffset a owl:NamedIndividual, bfe:AddressSpace ;
    rdfs:label "file offset"@en ;
    rdfs:comment "A byte offset from the beginning of a binary file."@en .
bfe:ObjectVirtualAddress a owl:NamedIndividual, bfe:AddressSpace ;
    rdfs:label "object virtual address"@en ;
    rdfs:comment "A virtual address as represented within the object file, before any runtime load bias is applied."@en .
bfe:ImageRelativeAddress a owl:NamedIndividual, bfe:AddressSpace ;
    rdfs:label "image-relative address"@en ;
    rdfs:comment "An address expressed relative to a stated image base."@en .
bfe:RuntimeVirtualAddress a owl:NamedIndividual, bfe:AddressSpace ;
    rdfs:label "runtime virtual address"@en ;
    rdfs:comment "A virtual address in a particular runtime mapping."@en .
bfe:UnknownAddressSpace a owl:NamedIndividual, bfe:AddressSpace ;
    rdfs:label "unknown address space"@en ;
    rdfs:comment "The source provides a numeric address but its coordinate system is not established."@en .

### Suggested usage conventions (not OWL closure axioms)

# Each selected candidate should have one CensusEntry in a census inventory.
# An entry should report one terminal disposition in the stored census dataset.
# An entry may link zero or more attempts; retry attempts remain distinct.
# A blocked entry should retain its first observed FailureObservation where known.
# An incomplete entry should retain an InterruptionObservation where known.
# Missing triples mean unknown/unrecorded, not false, zero, success, or completeness.
