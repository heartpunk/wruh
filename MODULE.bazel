module(name = "wruh", version = "0.1.0")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "ghot_vendored_arpy", version = "1.1.1")
bazel_dep(name = "ghot_vendored_mulpyplexer", version = "0.9")
bazel_dep(name = "ifrl", version = "0.1.0")
git_override(
    module_name = "ifrl",
    remote = "https://github.com/heartpunk/ifrl.git",
    commit = "46c35e52726d1f595d9d25e453062f5af1905db9",
)

local_path_override(module_name = "ghot_vendored_arpy", path = "third_party/arpy")
local_path_override(module_name = "ghot_vendored_mulpyplexer", path = "third_party/mulpyplexer")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

nix_python_runtime = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl", "local_runtime_repo"
)
nix_python_toolchains = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl", "local_runtime_toolchains_repo"
)
nix_python_runtime(
    name = "nix_python_3_12",
    interpreter_path = "python3.12",
    on_failure = "fail",
)
nix_python_toolchains(
    name = "nix_python_toolchains",
    runtimes = ["nix_python_3_12"],
    target_compatible_with = {"nix_python_3_12": ["HOST_CONSTRAINTS"]},
)
register_toolchains("@nix_python_toolchains//:all")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "extractor_pypi",
    python_interpreter = "python3.12",
    python_version = "3.12",
    requirements_by_platform = {
        "//extractor:requirements_linux_x86_64.txt": "linux_x86_64",
    },
)
override_repo(
    pip,
    extractor_pypi_312_arpy = "ghot_vendored_arpy",
    extractor_pypi_312_mulpyplexer = "ghot_vendored_mulpyplexer",
)
use_repo(pip, "extractor_pypi")

nix_native_deps = use_extension("@ifrl//bazel/wruh/tools:nix_native_deps.bzl", "nix_native_deps")
use_repo(nix_native_deps, "nix_native_deps")

ghot_inputs = use_repo_rule("//tools:ghot_inputs.bzl", "ghot_inputs_repository")
ghot_inputs(name = "ghot_inputs")
