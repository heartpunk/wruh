load("@wruh_pypi//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary")
load("//tools:reapi_artifact_action.bzl", "reapi_artifact_action")

package(default_visibility = ["//visibility:private"])

exports_files(["requirements_linux_x86_64.txt"])

_LINUX_X86_64 = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
]

[
    py_binary(
        name = stage,
        visibility = ["//visibility:public"],
        srcs = glob(["*.py"]),
        main = stage + "_cli.py",
        data = ["amd64_smoke.hex", "@nix_native_deps//:libstdcxx"],
        env = {"GHOT_LIBSTDCXX_RLOCATION": "$(rlocationpath @nix_native_deps//:libstdcxx)",
               "PYTHONNOUSERSITE": "1", "PYTHONSAFEPATH": "1"},
        target_compatible_with = _LINUX_X86_64,
        deps = ["@ayxg//:ayxg", "@ayxg//:z3", requirement("angr"), requirement("capstone"), requirement("pyelftools"), requirement("z3-solver")],
    ) for stage in ["extract", "compose"]
]

# Static-only zeroth-pass corpus analysis. Candidate ELFs are never executed.
py_binary(
    name = "corpus_probe",
    srcs = glob(["*.py"]),
    data = ["amd64_smoke.hex", "@nix_native_deps//:libstdcxx"],
    env = {"GHOT_LIBSTDCXX_RLOCATION": "$(rlocationpath @nix_native_deps//:libstdcxx)", "PYTHONNOUSERSITE": "1", "PYTHONSAFEPATH": "1"},
    main = "corpus_probe.py",
    target_compatible_with = _LINUX_X86_64,
    deps = ["@ayxg//:ayxg", "@ayxg//:z3", requirement("angr"), requirement("capstone"), requirement("pyelftools"), requirement("z3-solver")],
)

