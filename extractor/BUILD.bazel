[
    reapi_artifact_action(
        name = "cpython_extract_" + root,
        arguments = ["--root=" + root],
        dependencies = ["//evidence/cpython:identity.json"] + ["@nix_native_deps//:cpython/object_" + str(index) + "/" + name for index, name in enumerate(["python3.12", "libpython3.12.so.1.0", "ld-linux-x86-64.so.2", "libc.so.6", "libm.so.6"])],
        dependency_arguments = ["--identity={path}"] + ["--object={path}"] * 5,
        output = "cpython_extract_" + root + ".json",
        tool = ":cpython_probe",
        exec_compatible_with = _LINUX_X86_64,
        target_compatible_with = _LINUX_X86_64,
    ) for root in ["PyBytes_Size", "PyObject_Call", "PyFloat_AsDouble"]
]
