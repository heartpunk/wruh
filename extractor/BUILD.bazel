load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load(":shards.bzl", "extraction_settings", "integer_setting")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "test_runtime",
    srcs = glob(["*.py"]),
    data = ["amd64_smoke.hex"],
    visibility = ["//tests:__pkg__"],
    deps = ["@shared_angr//:pkg", "@wruh_ayxg//:z3", "@wruh_equanimity//:backend"],
)

py_test(
    name = "angr_runtime_smoke",
    srcs = glob(["*.py"]),
    main = "angr_smt_smoke.py",
    data = ["@nix_native_deps//:libstdcxx"],
    env = {
        "GHOT_LIBSTDCXX_RLOCATION": "$(rlocationpath @nix_native_deps//:libstdcxx)",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
    },
    deps = ["@shared_angr//:pkg"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)


exports_files(["BUILD.bazel"], visibility = ["//visibility:public"])

py_binary(
    name = "fresh_extract",
    srcs = ["extract_cli.py"],
    main = "extract_cli.py",
    data = ["@nix_native_deps//:libstdcxx"],
    visibility = ["//lua:__pkg__"],
    deps = [":test_runtime"],
)

py_binary(
    name = "merge_fresh",
    srcs = ["shard_bundle.py"],
    main = "shard_bundle.py",
    visibility = ["//lua:__pkg__"],
    deps = ["@wruh_ayxg//:ayxg"],
)

integer_setting(
    name = "lua_window_bytes",
    build_setting_default = 256,
)

integer_setting(
    name = "lua_scope_bytes",
    build_setting_default = 1024,
)

extraction_settings(
    name = "lua_settings",
    scope_bytes = ":lua_scope_bytes",
    window_bytes = ":lua_window_bytes",
    out = "lua-settings.json",
)
