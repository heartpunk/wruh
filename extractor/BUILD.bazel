[
 reapi_artifact_action(
  name = "corpus_native_prepare_O" + optimization,
  arguments = ["--mode=prepare-native", "--optimization=" + optimization],
  dependencies = ["//corpus:templates.c", "//corpus:native/harness.c"],
  dependency_arguments = ["--source={path}"] * 2,
  output = "corpus_native_prepare_O" + optimization + ".json",
  tool = ":corpus_probe",
  exec_compatible_with = _LINUX_X86_64,
  target_compatible_with = _LINUX_X86_64,
 ) for optimization in ["0", "2"]
]

[
 reapi_artifact_action(
  name = "corpus_native_model_O" + optimization + "_" + root,
  arguments = ["--mode=native-model", "--root=" + root],
  dependencies = [":corpus_native_prepare_O" + optimization],
  dependency_arguments = ["--scan={path}"],
  output = "corpus_native_model_O" + optimization + "_" + root + ".json",
  tool = ":corpus_probe",
  exec_compatible_with = _LINUX_X86_64,
  target_compatible_with = _LINUX_X86_64,
 ) for optimization in ["0", "2"] for root in ["alias", "overlap", "division"]
]
filegroup(name = "corpus_native_models", srcs = [
 ":corpus_native_model_O" + optimization + "_" + root
 for optimization in ["0", "2"] for root in ["alias", "overlap", "division"]])

py_binary(
 name = "native_differential",
 srcs = glob(["*.py"]) + ["//corpus:native/sandbox.py"],
 main = "native_differential.py",
 data = [":corpus_native_prepare_O0.json", ":corpus_native_prepare_O2.json"] + [
  ":corpus_native_model_O" + opt + "_" + root + ".json"
  for opt in ["0", "2"] for root in ["alias", "overlap", "division"]],
 args = ["--binary=$(rlocationpath :corpus_native_prepare_O0.json)", "--binary=$(rlocationpath :corpus_native_prepare_O2.json)"] + [
  "--model=$(rlocationpath :corpus_native_model_O" + opt + "_" + root + ".json)"
  for opt in ["0", "2"] for root in ["alias", "overlap", "division"]],
 deps = ["@ayxg//:ayxg", requirement("hypothesis"), "@rules_python//python/runfiles"],
 target_compatible_with = _LINUX_X86_64,
)

