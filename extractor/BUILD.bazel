load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@wruh_census_binaries//:metadata.bzl", "CENSUS_METADATA")

package(default_visibility = ["//visibility:private"])

py_test(
    name = "angr_runtime_smoke",
    srcs = glob(["*.py"], exclude = ["binary_census.py"]),
    main = "angr_smt_smoke.py",
    data = ["@nix_native_deps//:libstdcxx"],
    env = {
        "GHOT_LIBSTDCXX_RLOCATION": "$(rlocationpath @nix_native_deps//:libstdcxx)",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
    },
    deps = ["@shared_angr//:pkg"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)


py_library(
    name = "binary_census_runtime",
    srcs = glob(["*.py"], exclude = ["binary_census.py"]),
    deps = [
        "@shared_angr//:pkg",
        "@wruh_ayxg//:z3",
    ],
)

py_binary(
    name = "binary_census",
    srcs = ["binary_census.py"],
    main = "binary_census.py",
    data = ["@nix_native_deps//:libstdcxx"],
    env = {
        "GHOT_LIBSTDCXX_RLOCATION": "$(rlocationpath @nix_native_deps//:libstdcxx)",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
    },
    deps = [":binary_census_runtime"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)

def _binary_census_remote_test(target_id, target_kind, implementation = None):
    metadata = CENSUS_METADATA[target_id]
    args = [
        "--binary",
        "$(rlocationpath @wruh_census_binaries//:{})".format(target_id),
        "--binary-identifier",
        metadata["binary_identifier"],
        "--target-id",
        target_id,
        "--target-kind",
        target_kind,
        "--target-version",
        metadata["target_version"],
        "--target-platform",
        "x86_64-linux",
        "--build-package",
        metadata["build_package"],
        "--build-configuration",
        metadata["build_configuration"],
        "--build-output",
        metadata["build_output"],
        "--nixpkgs-revision",
        metadata["nixpkgs_revision"],
        "--ayxg-revision",
        metadata["ayxg_revision"],
    ]
    if implementation:
        args.extend(["--target-implementation", implementation])

    py_test(
        name = "binary_census_{}_remote_test".format(target_id),
        srcs = ["binary_census.py"],
        main = "binary_census.py",
        size = "enormous",
        timeout = "eternal",
        args = args,
        data = [
            "@nix_native_deps//:libstdcxx",
            "@wruh_census_binaries//:{}".format(target_id),
        ],
        env = {
            "GHOT_LIBSTDCXX_RLOCATION": "$(rlocationpath @nix_native_deps//:libstdcxx)",
            "PYTHONNOUSERSITE": "1",
            "PYTHONSAFEPATH": "1",
        },
        deps = [":binary_census_runtime"],
        target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    )


_binary_census_remote_test("lua", "interpreter", "Lua")
_binary_census_remote_test("quickjs", "interpreter", "QuickJS")
_binary_census_remote_test("cpython", "interpreter", "CPython")
_binary_census_remote_test("apache", "generic")
_binary_census_remote_test("node", "interpreter", "Node.js")
_binary_census_remote_test("bun", "interpreter", "Bun")
