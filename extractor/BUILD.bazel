load("@rules_python//python:defs.bzl", "py_library", "py_test")

package(default_visibility = ["//visibility:private"])

py_library(
    name = "test_runtime",
    srcs = glob(["*.py"]),
    data = ["amd64_smoke.hex"],
    visibility = ["//tests:__pkg__"],
    deps = ["@shared_angr//:pkg", "@wruh_ayxg//:z3", "@wruh_equanimity//:backend"],
)

py_test(
    name = "angr_runtime_smoke",
    srcs = glob(["*.py"]),
    main = "angr_smt_smoke.py",
    data = ["@nix_native_deps//:libstdcxx"],
    env = {
        "GHOT_LIBSTDCXX_RLOCATION": "$(rlocationpath @nix_native_deps//:libstdcxx)",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
    },
    deps = ["@shared_angr//:pkg"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
)


exports_files(["BUILD.bazel"], visibility = ["//visibility:public"])
